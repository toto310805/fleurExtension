{
    "name": "Fleur",
    "scopeName": "source.fleur",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#accessors"
        },
        {
            "include": "#types"
        },
        {
            "include": "#methods"
        },
        {
            "include": "#namespaces"
        },
        {
            "include": "#properties"
        },
        {
            "include": "#objectkeys"
        },
        {
            "include": "#ranges"
        },
        {
            "include": "#punctuation"
        },
        {
            "include": "#dot"
        },
        {
            "include": "#variableDeclarations"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.fleur",
                    "match": "//.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.fleur",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.fleur",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.fleur",
                    "match": "\\b\\d+(\\.\\d+)?\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.fleur",
                    "match": "\\b(if|else|when|for|in|while|return)\\b"
                },
                {
                    "name": "keyword.declaration.fleur",
                    "match": "\\b(const|var|func|proc|struct)\\b"
                },
                {
                    "name": "keyword.operator.logical.fleur",
                    "match": "\\b(and|or|not)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.fleur",
                    "match": "\\b(true|false|null)\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.fleur",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.fleur",
                    "match": "==|!=|<=|>=|=>|\\+=|-=|\\*=|/=|%=|=|<|>|\\+|-|\\*|/|%"
                }
            ]
        },
        "accessors": {
            "patterns": [
                {
                    "name": "punctuation.accessor.fleur",
                    "match": "::"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "entity.name.type.fleur",
                    "match": "(?<=\\bstruct\\s)[A-Z][a-zA-Z0-9_]*"
                },
                {
                    "name": "entity.name.type.fleur",
                    "match": "\\b[A-Z][a-zA-Z0-9_]*\\b(?=\\s*\\{)"
                }
            ]
        },
        "methods": {
            "patterns": [
                {
                    "name": "entity.name.function.method.fleur",
                    "match": "(?<=::)[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
                }
            ]
        },
        "namespaces": {
            "patterns": [
                {
                    "name": "support.namespace.fleur",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=::)"
                }
            ]
        },
        "properties": {
            "patterns": [
                {
                    "name": "variable.other.property.fleur",
                    "match": "(?<=\\.)[a-zA-Z_][a-zA-Z0-9_]*"
                }
            ]
        },
        "objectkeys": {
            "patterns": [
                {
                    "name": "varuable.other.property.fleur",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*:)"
                }
            ]
        },
        "ranges": {
            "patterns": [
                {
                    "name": "keyword.operator.range.fleur",
                    "match": "\\.\\."
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.bracket.fleur",
                    "match": "[{}\\[\\]()]"
                },
                {
                    "name": "punctuation.separator.fleur",
                    "match": "[,;:]"
                }
            ]
        },
        "dot": {
            "patterns": [
                {
                    "name": "punctuation.accessor.fleur",
                    "match": "\\."
                }
            ]
        },
        "variableDeclarations": {
            "patterns": [
                {
                    "name": "variable.other.declaration.fleur",
                    "match": "(?<=(const|var)\\s)[a-zA-Z_][a-zA-Z0-9_]*"
                }
            ]
        }
    }
}